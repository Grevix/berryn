{
  "name": "berryn-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Berryn — Migration, compatibility, and validation infrastructure",
  "author": "Berryn Core Engineering Team",
  "license": "MIT",
  "scripts": {
    "build": "tsc --build",
    "clean": "pnpm -r --filter \"./packages/*\" exec rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc --build",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "format": "prettier --check \"packages/*/src/**/*.ts\"",
    "verify": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
