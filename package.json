{
  "name": "berryn-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Berryn — Migration, compatibility, and validation infrastructure",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grevix/berryn.git"
  },
  "homepage": "https://github.com/Grevix/berryn#readme",
  "bugs": {
    "url": "https://github.com/Grevix/berryn/issues"
  },
  "author": "Berryn Core Engineering Team",
  "license": "MIT",
  "scripts": {
    "build": "tsc --build",
    "clean": "pnpm -r --filter \"./packages/*\" exec rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc --build",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "format": "prettier --check \"packages/*/src/**/*.ts\"",
    "verify": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
