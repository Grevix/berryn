{
  "name": "@berryn/xlsx-inspect",
  "version": "0.1.1",
  "description": "Berryn XLSX Inspection — ZIP container inventory, OPC relationship graph resolver, and feature classification",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grevix/berryn.git"
  },
  "homepage": "https://github.com/Grevix/berryn#readme",
  "bugs": {
    "url": "https://github.com/Grevix/berryn/issues"
  },
  "license": "MIT",
  "author": "Berryn Core Engineering Team",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@berryn/core": "workspace:*",
