{
  "name": "@berryn/exceljs-compat",
  "version": "0.1.0",
  "description": "Berryn ExcelJS Compatibility Facade — Narrow, evidence-gated import replacement for ExcelJS",
  "repository": {
    "type": "git",
    "url": "https://github.com/Grevix/berryn.git"
  },
  "homepage": "https://github.com/Grevix/berryn",
  "bugs": {
    "url": "https://github.com/Grevix/berryn/issues"
  },
  "license": "MIT",
  "author": "Berryn Core Engineering Team",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@berryn/core": "workspace:*",
    "@berryn/diagnostics": "workspace:*",
    "@berryn/xlsx-inspect": "workspace:*"
  },
  "devDependencies": {}
}
