{
  "name": "@berryn/migration-report",
  "version": "0.2.1",
  "description": "Berryn Migration Report — JSON schema validator and Markdown human summary generator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grevix/berryn.git"
  },
  "homepage": "https://github.com/Grevix/berryn#readme",
  "bugs": {
    "url": "https://github.com/Grevix/berryn/issues"
  },
  "license": "MIT",
  "author": "Berryn Core Engineering Team",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@berryn/core": "0.2.1",
    "@berryn/diagnostics": "0.2.1"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
